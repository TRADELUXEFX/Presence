<?xml version="1.0" encoding="utf-8"?>
<!-- Daily notice: app icon, the message, then a Start button. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">


    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/notice_daily_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Presence"
            android:textAppearance="@android:style/TextAppearance.Material.Notification.Title"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/notice_daily_sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No training done"
            android:textAppearance="@android:style/TextAppearance.Material.Notification"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Start button: the mountain icon, then the label, as in Real Pause's Log button -->
    <LinearLayout
        android:id="@+id/notice_daily_btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/notice_daily_btn"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="20dp"
        android:paddingBottom="10dp">

        <ImageView
            android:id="@+id/notice_daily_btn_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_btn_mountain" />

        <TextView
            android:id="@+id/notice_daily_btn_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Start"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
